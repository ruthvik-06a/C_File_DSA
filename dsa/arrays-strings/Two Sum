#include<stdio.h>
#include<stdlib.h>

int* twoSum(int* nums, int numsSize, int target, int* returnSize)
 {
    int i,j;
    int *result = malloc(2*sizeof(int));
    for(i=0;i<numsSize;i++){
        for(j=1;j<numsSize;j++){
        if(target==nums[i]+nums[j])
        {
            result[0]=i;
            result[1]=j;

            *returnSize=2;

           return result;
            
        }
    }
    
    }
    *returnSize=0;
    return NULL;
}
